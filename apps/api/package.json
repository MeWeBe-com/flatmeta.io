{
  "name": "flatmeta-api",
  "version": "2.0.0",
  "private": true,
  "description": "FlatMeta v2 API: REST (/v1), WebSocket live feed, MCP server, workers and the showcase generator",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/src/server.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env seed/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run showcase -- --countries all --approve",
    "showcase": "tsx --env-file-if-exists=../../.env src/showcase/cli.ts",
    "images:import": "tsx --env-file-if-exists=../../.env src/showcase/import-external.ts",
    "mcp:stdio": "tsx --env-file-if-exists=../../.env src/mcp/stdio.ts",
    "openapi:export": "tsx --env-file-if-exists=../../.env scripts/export-openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@flatmeta/shared": "*",
    "@google/genai": "^2.31.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "bullmq": "^6.5.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "i18n-iso-countries": "^7.14.0",
    "ioredis": "^6.0.0",
    "marked": "^18.1.2",
    "nodemailer": "^10.2.1",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "resend": "^6.37.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "standardwebhooks": "^1.1.1",
    "stripe": "^23.0.1",
    "tldts": "^7.4.19",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
