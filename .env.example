# ─────────────────────────────────────────────────────────────────────────────
# FlatMeta web — environment. Copy to .env and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Where the Next.js server reaches the API (server-side fetches and dev rewrites)
API_INTERNAL_URL=http://127.0.0.1:4000          # staging: http://127.0.0.1:4100

# Public URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000      # https://flatmeta.io
NEXT_PUBLIC_API_DOCS_URL=http://localhost:4000/docs   # https://api.flatmeta.io/docs
NEXT_PUBLIC_MCP_URL=http://localhost:4000/mcp         # https://api.flatmeta.io/mcp
# Live WebSocket. Empty = same origin (/api/v1/live, proxied by nginx). In dev point it at the API directly.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/v1/live

# Environment label + staging subdomain (config value, shown as a banner on staging)
NEXT_PUBLIC_APP_ENV=development                 # development | staging | production
NEXT_PUBLIC_STAGING_HOST=staging.flatmeta.io

# Map (vector tiles in the OpenMapTiles schema). Defaults use OpenFreeMap (free, no key).
# To self-host: serve a Protomaps/OpenMapTiles PMTiles archive and point these at it.
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/planet
NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
NEXT_PUBLIC_MAP_STYLE_URL=                      # optional: a full style.json URL overrides the built-in FlatMeta styles
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors · OpenFreeMap

# Optional analytics (Plausible-compatible, privacy friendly); leave empty to disable
# Show "Continue with Google" (set GOOGLE_CLIENT_ID/SECRET on the API first)
NEXT_PUBLIC_GOOGLE_AUTH=false

NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

PORT=3000                                       # staging: 3100
