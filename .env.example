# ─────────────────────────────────────────────────────────────────────────────
# FlatMeta — environment for the whole monorepo (web + api + worker).
# Copy to .env at the repo root and fill in. Never commit real values.
# Everything third-party is optional: without keys the API runs in dev mode
# (console email, mock payments, heuristic AI, procedural images).
# ─────────────────────────────────────────────────────────────────────────────

# --- App ---------------------------------------------------------------------
APP_NAME=FlatMeta
NODE_ENV=development            # development | production | test
# With NODE_ENV=production npm skips devDependencies, but building needs them (tsc, tsx, Next build tools).
# scripts/deploy.sh always installs them (`npm ci --include=dev`). For manual installs on the server, keep:
NPM_CONFIG_INCLUDE=dev
DEPLOY_PRUNE=0                  # 1 = run `npm prune --omit=dev` after each deploy (saves disk; breaks tsx-based scripts like db:seed)
APP_ENV=development             # development | staging | production. set it with NODE_ENV=production: if missing, production rules apply (staging must say staging);
                                # the test conveniences below (on-screen codes, fake checkout) are allowed only when APP_ENV is not production
# Public origin of the site. EVERY absolute URL, redirect, email link, sitemap entry and share card is built
# from this. Production refuses to start if it contains localhost or 127.0.0.1.
APP_URL=http://localhost:3200                # https://flatmeta.io
API_URL=                                     # public API base (docs, MCP, webhooks); empty = $APP_URL/api
USERCONTENT_URL=                             # separate origin for owner custom HTML, e.g. https://usercontent.flatmeta.io (docs/deploy-hestia.md); empty = /api on the same origin (dev only)
USERCONTENT_CONNECT_HOSTS=                   # hostnames owner custom HTML may fetch from, comma-separated; empty = none
PRODUCTION_DOMAIN=flatmeta.io
STAGING_DOMAIN=staging.flatmeta.io             # live staging (HestiaCP); staging shows a banner and is noindex

# Ports. 3000, 3010 and 3100 are taken on the shared server; every default avoids them.
HOST=127.0.0.1
WEB_PORT=3200                   # Next.js
PORT=3201                       # API (Fastify)
MCP_PORT=                       # optional: also serve /mcp alone on this port (e.g. 3202)
WORKER_HEALTH_PORT=3203         # worker health endpoint (/healthz)
LOG_LEVEL=info
TRUST_PROXY=true                # behind the Hestia/nginx proxy

# Where the Next.js server reaches the API (server-side only, never sent to browsers).
# Must match PORT above. (Next overwrites PORT for its own process, so it cannot be derived.)
API_INTERNAL_URL=http://127.0.0.1:3201

# --- Data --------------------------------------------------------------------
DATABASE_URL=postgres://flatmeta:flatmeta@localhost:5432/flatmeta
DATABASE_URL_TEST=postgres://flatmeta:flatmeta@localhost:5432/flatmeta_test
REDIS_URL=redis://localhost:6379/0          # staging: use another DB index, e.g. /1
REDIS_PREFIX=fm

# --- Auth & sessions ---------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 32
COOKIE_DOMAIN=                  # e.g. .flatmeta.io (empty = host-only cookie)
COOKIE_SECURE=false             # true in production
SEED_ADMIN_EMAIL=admin@flatmeta.io
GOOGLE_CLIENT_ID=               # optional Google sign-in
GOOGLE_CLIENT_SECRET=

# --- Email (sign-in codes, marketplace, clan invites, claims, admin notices) -----
# Provider: RESEND_API_KEY set → Resend; else SMTP_HOST set → SMTP; else emails are only logged (not sent).
# With a real provider, emails go through the worker queue (retries with backoff, provider rate limit).
# Without one (development, staging before keys), sign-in codes are shown on screen (DEV_CODE_ECHO).
# Production needs a provider: it never shows codes and never logs email bodies.
RESEND_API_KEY=                 # re_… from https://resend.com/api-keys (sending access is enough). Never commit it.
RESEND_WEBHOOK_SECRET=          # whsec_… from Resend → Webhooks (endpoint $API_URL/v1/email/webhooks/resend); suppresses bounces and complaints
MAIL_FROM="FlatMeta <hello@flatmeta.io>"   # must be on a domain verified in Resend
MAIL_REPLY_TO=                  # optional, e.g. support@flatmeta.io
EMAIL_QUEUE=auto                # auto = queue via the worker when a provider is set; true | false
EMAIL_RATE_PER_SECOND=2         # Resend's default API limit; raise only if your Resend plan allows
ADMIN_EMAILS=                   # extra comma-separated addresses for admin notices (DB admins always get them)
DEV_CODE_ECHO=auto              # auto = show codes on screen only when no provider is set and APP_ENV != production; true | false
# SMTP fallback (used only when RESEND_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- Media storage -----------------------------------------------------------
STORAGE_DRIVER=local            # local | s3
MEDIA_DIR=./storage/media       # local driver: nginx serves this at /media
MEDIA_PUBLIC_URL=/media         # URL prefix the browser uses for media
S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=                  # public base URL of the bucket

# --- Payments (Stripe) -------------------------------------------------------
# Full setup and the live checklist: docs/stripe-live.md. Checkout is a redirect to Stripe Checkout, so no
# publishable key (pk_…) is needed anywhere.
STRIPE_SECRET_KEY=              # sk_test_… on staging, sk_live_… (or a restricted rk_live_…) on production.
                                # A test key on APP_ENV=production: admins see a red warning and checkout is refused.
STRIPE_WEBHOOK_SECRET=          # whsec_… of the endpoint https://<APP_URL host>/api/v1/stripe/webhook (one per environment)
# Subscription prices. Leave empty to use the prices scripts/stripe-sync.ts creates (found by lookup key
# <STRIPE_LOOKUP_PREFIX>_<plan>_<interval>, e.g. flatmeta_plus_month); set a price_… here to pin one.
STRIPE_PRICE_PLUS_MONTH=
STRIPE_PRICE_PLUS_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
STRIPE_PRICE_BRAND_MONTH=
STRIPE_PRICE_BRAND_YEAR=
STRIPE_LOOKUP_PREFIX=flatmeta
STRIPE_AUTOMATIC_TAX=false      # true once Stripe Tax is set up (origin address and registrations in the dashboard)
CURRENCY=usd                    # one currency for land, boosts, AI packs, marketplace and plans (stripe-sync uses it too)
# Launch switch: paid land, plans, boosts, AI packs, marketplace and Landmark checkout. auto = off in production
# (everything paid shows "coming soon"), on elsewhere. Set true once Stripe is configured and tested. The web
# build reads it too: redeploy after changing it.
PAID_CHECKOUT_ENABLED=auto
FREE_LAND_CELLS=100             # while paid checkout is off: free squares per person / organisation
PAYMENTS_MOCK=true              # fake checkout when STRIPE_SECRET_KEY is empty; allowed in development and staging, always off when APP_ENV=production
# Marketplace (Stripe Connect payouts to sellers)
MARKETPLACE_FEE_BPS=1000        # platform fee, 1000 = 10%
MARKETPLACE_MIN_HOLD_DAYS=7
MARKETPLACE_PRICE_CAP_MULT=50
MARKETPLACE_PRICE_CAP_DAYS=30
MARKETPLACE_MIN_PRICE_CENTS=200
PAYOUT_MIN_CENTS=500

# Showcase plots need an admin-checked location (Admin → Showcase locations) before they go public. auto = in production.
SHOWCASE_REQUIRE_LOCATION_CHECK=auto
# Shown in the legal pages
COMPANY_NAME=MeWeBe
COMPANY_COUNTRY=United Kingdom
CONTACT_EMAIL=hello@flatmeta.io

# --- AI ----------------------------------------------------------------------
# Text: anthropic | openai | gemini | heuristic (empty = first provider with a key, else heuristic)
AI_TEXT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODEL_FAST=claude-opus-5-5        # used for moderation / search intent; e.g. claude-haiku-5-5 to save cost
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
# Images: procedural | openai | gemini | external (Google Flow or any manual pipeline)
AI_IMAGE_PROVIDER=procedural
EXTERNAL_IMAGE_DIR=./storage/external       # outbox/prompts.jsonl → inbox/{id}.png
# Moderation: openai | anthropic | heuristic (empty = openai if key, else anthropic, else heuristic)
AI_MODERATION_PROVIDER=
MODERATION_BLOCKLIST=           # extra comma-separated words/phrases the heuristic moderator always flags

# --- Maps & geocoding --------------------------------------------------------
GEOCODER_URL=https://photon.komoot.io/api   # Photon-compatible; self-host for production volume
GEOCODER_USER_AGENT=FlatMeta/2.0 (hello@flatmeta.io)

# --- Limits ------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=300

# --- Web (browser-visible; none of these are secret) --------------------------
# APP_NAME, APP_URL, APP_ENV, PRODUCTION_DOMAIN and STAGING_DOMAIN above are shared with the web app.
NEXT_PUBLIC_API_DOCS_URL=       # empty = $APP_URL/api/docs
NEXT_PUBLIC_MCP_URL=            # empty = $APP_URL/api/mcp
# Live WebSocket. Empty = same origin (/api/v1/live through the proxy). In dev set ws://localhost:3201/v1/live
NEXT_PUBLIC_WS_URL=ws://localhost:3201/v1/live
# Map: vector tiles in the OpenMapTiles schema. Defaults use OpenFreeMap (free, no key); self-host for scale.
NEXT_PUBLIC_MAP_TILES_URL=https://tiles.openfreemap.org/planet
NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
NEXT_PUBLIC_MAP_STYLE_URL=      # optional: a full style.json URL overrides the built-in FlatMeta styles
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors · OpenFreeMap
NEXT_PUBLIC_GOOGLE_AUTH=false   # show "Continue with Google" (needs GOOGLE_CLIENT_ID/SECRET above)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=   # optional privacy-friendly analytics
